# Copy to .env. Every setting is optional; the defaults are in app/config.py.

# Who is asking. Put a URL or address a site operator can reach you at.
SCRAPER_USER_AGENT=fdiet-scrapper/0.1 (+https://example.org/contact)
SCRAPER_RESPECT_ROBOTS=true
# Hosts whose robots.txt is not consulted (JSON). Mercadona's disallows /api, which its adapter reads.
# SCRAPER_ROBOTS_EXEMPT_HOSTS=["tienda.mercadona.es"]

# Politeness: seconds between two requests to the same host, plus up to the jitter.
SCRAPER_MIN_DELAY_SECONDS=2.0
SCRAPER_JITTER_SECONDS=1.0
SCRAPER_TIMEOUT_SECONDS=30

# Retries on timeouts, connection errors, 429 and 5xx.
SCRAPER_MAX_RETRIES=3
SCRAPER_BACKOFF_BASE_SECONDS=4
SCRAPER_BACKOFF_MAX_SECONDS=120
SCRAPER_MAX_RETRY_AFTER_SECONDS=600
SCRAPER_MAX_CONSECUTIVE_FAILURES=10

# A full sync of one supermarket at most this often (force=true overrides).
SCRAPER_SYNC_COOLDOWN_HOURS=12

SCRAPER_DATA_DIR=data

SCRAPER_MERCADONA_WAREHOUSE=mad1
SCRAPER_MERCADONA_PRODUCT_DETAILS=true
SCRAPER_LUPA_SITEMAP=https://www.lupaonline.com/media/sitemap/sitemap_santande.xml
# Lists are JSON.
# SCRAPER_LIDL_OFFER_PAGES=["https://www.lidl.es/c/ofertas-semanales/a10089449"]
# SCRAPER_EROSKI_FOOD_SECTIONS=["2059698","2059806","2059919","2060118","2060211"]
# SCRAPER_ALDI_EXCLUDED_CATEGORIES=["bazar","cuidado-personal","limpieza-y-hogar","mascotas"]

# Logs: "json" (one object per line, what docker compose ships to OpenSearch) or "text".
SCRAPER_LOG_FORMAT=text
SCRAPER_LOG_LEVEL=INFO
SCRAPER_LOG_PROGRESS_EVERY=250

# The food sync (POST /food-sync): OpenSearch, and the fdiet backend whose foods are matched.
# Inside docker compose these are set to http://opensearch:9200 and http://backend:5000.
SCRAPER_OPENSEARCH_URL=http://localhost:9200
SCRAPER_OPENSEARCH_PREFIX=fdiet
SCRAPER_FDIET_API_URL=http://localhost:5000
SCRAPER_FDIET_API_PAGE_SIZE=200
SCRAPER_OPENSEARCH_BULK_SIZE=500
SCRAPER_OPENSEARCH_MSEARCH_SIZE=100
SCRAPER_FOOD_SYNC_MATCHES_PER_SUPERMARKET=3
