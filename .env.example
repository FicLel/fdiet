# Copy to `.env` and fill in by hand. `.env` is gitignored.
# Read by `gradlew bootRun`, `gradlew test` and the `gradlew flyway*` tasks.
# A real exported environment variable always overrides the value here.

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=fdiet
MYSQL_USER=
MYSQL_PASSWORD=

# Optional
SERVER_PORT=5000
FOOD_CSV_PATH=fooddata.csv

# --- docker compose (compose.yaml) -------------------------------------------
# Read only by `docker compose`; every entry is optional. The MYSQL_* entries above are
# for gradlew and are not used by compose (MySQL's image refuses MYSQL_USER=root).
# FDIET_DB_NAME=fdiet
# FDIET_DB_USER=fdiet
# FDIET_DB_PASSWORD=fdiet
# FDIET_DB_ROOT_PASSWORD=fdiet-root
# Host ports (all bound to 127.0.0.1). 3307 so a local MySQL on 3306 keeps running.
# FDIET_DB_HOST_PORT=3307
# FDIET_BACKEND_PORT=5000
# FDIET_UI_PORT=8080
# FDIET_SCRAPPER_PORT=8000
# FDIET_OPENSEARCH_PORT=9200
# FDIET_DASHBOARDS_PORT=5601
# FDIET_OPENSEARCH_HEAP=1g
